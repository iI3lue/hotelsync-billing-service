generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * Folio de cargos por estancia (BL-1).
 * Se abre con `booking.confirmed` (cargo inicial = tarifa de la reserva) y
 * acumula cargos de servicios (minibar, spa, restaurante) hasta el cierre.
 * `booking_id` es la clave de idempotencia. Sin FK entre bases: la
 * referencia a Booking/Property es solo el UUID.
 */
model Folio {
  folio_id   String   @id @default(uuid()) @db.Uuid
  booking_id String   @unique @db.Uuid
  hotel_id   String   @db.Uuid
  guest_id   String   @db.Uuid
  currency   String   @default("COP") @db.VarChar(10)
  total      Decimal  @default(0) @db.Decimal(12, 2)
  status     String   @default("open") @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  charges Charge[]
  invoice Invoice?

  @@index([hotel_id, status])
  @@index([booking_id])
  @@map("folios")
}

model Charge {
  charge_id String   @id @default(uuid()) @db.Uuid
  folio_id  String   @db.Uuid
  concept   String   @db.VarChar(200)
  amount    Decimal  @db.Decimal(12, 2)
  category  String   @default("other") @db.VarChar(20)
  added_at  DateTime @default(now()) @db.Timestamptz(6)

  folio Folio @relation(fields: [folio_id], references: [folio_id], onDelete: Cascade)

  @@index([folio_id])
  @@map("charges")
}

/**
 * Factura final cerrada en el checkout (BL-2, BL-3, BL-4).
 * Una por folio; el cierre es idempotente. `invoice_number` determinístico
 * derivado del folio para evitar contadores con carreras.
 */
model Invoice {
  invoice_id     String   @id @default(uuid()) @db.Uuid
  folio_id       String   @unique @db.Uuid
  invoice_number String   @unique @db.VarChar(40)
  subtotal       Decimal  @db.Decimal(12, 2)
  tax_rate       Decimal  @db.Decimal(5, 4)
  tax_amount     Decimal  @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  currency       String   @db.VarChar(10)
  country        String   @db.VarChar(10)
  issued_at      DateTime @default(now()) @db.Timestamptz(6)

  folio Folio @relation(fields: [folio_id], references: [folio_id], onDelete: Cascade)

  @@index([folio_id])
  @@map("invoices")
}

model EventOutbox {
  event_id   String    @id @default(uuid()) @db.Uuid
  event_type String    @db.VarChar(50)
  payload    Json      @db.Json
  status     String    @default("pending") @db.VarChar(20)
  attempts   Int       @default(0)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  sent_at    DateTime? @db.Timestamptz(6)

  @@index([status, created_at])
  @@map("event_outbox")
}
