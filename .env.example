# Copiar a .env (nunca commitear valores reales)
NODE_ENV=development
PORT=3007
# Conexion con pooling para runtime (Neon pooled + ?pgbouncer=true)
DATABASE_URL=postgresql://usuario:password@host:5432/billing_db?sslmode=require
# Conexion directa SIN pooling, solo para `prisma migrate deploy`
DIRECT_URL=postgresql://usuario:password@host:5432/billing_db?sslmode=require
# URLs base de dependencias (ej. https://xxx.onrender.com/v1)
BOOKING_SERVICE_URL=http://localhost:3004/v1
PROPERTY_SERVICE_URL=http://localhost:3001/v1
# RabbitMQ (CloudAMQP). Vacio = eventos deshabilitados, el servicio arranca igual.
RABBITMQ_URL=
# Moneda por defecto para facturas
DEFAULT_CURRENCY=COP

# HS256 compartido con user-service (min 32 chars)
AUTH_JWT_SECRET=

# Debe coincidir con BILLING_SERVICE_KEY de Booking (header x-billing-key)
BOOKING_SERVICE_KEY=
